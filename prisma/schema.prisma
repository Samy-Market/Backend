generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  SUPERVISOR
  ADMIN
}

enum AttendanceType {
  IN
  OUT
}

enum AttendanceSource {
  WEB
  MANUAL
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              Role      @default(EMPLOYEE)
  active            Boolean   @default(true)
  /// Los tokens emitidos antes de esta fecha dejan de valer (cierra sesiones al cambiar la contraseña)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee       Employee?
  passwordResets PasswordReset[]
  reviews        Justification[] @relation("Reviewer")
  auditLogs      AuditLog[]
  transfers      SiteTransfer[]  @relation("TransferAuthor")
  leaves         Leave[]         @relation("LeaveAuthor")
}

model Site {
  id           String   @id @default(uuid())
  name         String   @unique
  address      String?
  active       Boolean  @default(true)
  lat          Float?
  lng          Float?
  radiusMeters Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees   Employee[]
  attendances Attendance[]
  transfers   SiteTransfer[]
}

model SiteTransfer {
  id         String   @id @default(uuid())
  employeeId String
  siteId     String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  createdBy  String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id])
  author   User     @relation("TransferAuthor", fields: [createdBy], references: [id])

  @@index([employeeId, startDate])
  @@index([siteId, startDate])
}

model Shift {
  id               String @id @default(uuid())
  name             String
  startTime        String
  endTime          String
  toleranceMinutes Int    @default(0)

  scheduleDays ScheduleDay[]
}

model Schedule {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days        ScheduleDay[]
  assignments ScheduleAssignment[]
}

model ScheduleDay {
  id         String  @id @default(uuid())
  scheduleId String
  weekday    Int
  shiftId    String?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, weekday])
}

/// Fechas en día local (APP_TIMEZONE), ambas inclusivas; endDate nulo = sin fecha de fin.
model ScheduleAssignment {
  id              String    @id @default(uuid())
  employeeId      String
  scheduleId      String
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  /// Si se recortó al asignar otro horario: hasta cuándo iba antes (null = sin fin)
  trimmed         Boolean   @default(false)
  originalEndDate DateTime? @db.Date
  createdAt       DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id])

  @@index([employeeId, startDate])
  @@index([scheduleId])
}

model Employee {
  id         String  @id @default(uuid())
  userId     String  @unique
  fullName   String
  documentId String  @unique
  position   String
  siteId     String
  active     Boolean @default(true)

  user           User                 @relation(fields: [userId], references: [id])
  site           Site                 @relation(fields: [siteId], references: [id])
  attendances    Attendance[]
  justifications Justification[]
  assignments    ScheduleAssignment[]
  transfers      SiteTransfer[]
  leaves         Leave[]
}

model Attendance {
  id              String           @id @default(uuid())
  employeeId      String
  type            AttendanceType
  /// Siempre asignado por el servidor (UTC)
  timestamp       DateTime         @default(now())
  source          AttendanceSource @default(WEB)
  /// Copia fija calculada al registrar el IN
  isLate          Boolean          @default(false)
  lateMinutes     Int              @default(0)
  /// Minutos que llegó antes de su hora de entrada (copia fija al registrar el IN). No suman horas.
  preEntryMinutes Int              @default(0)
  siteId          String?
  /// Ubicación enviada por el celular al marcar; distanceMeters es a la sede si tiene ubicación configurada
  latitude        Float?
  longitude       Float?
  accuracyMeters  Int?
  distanceMeters  Int?
  /// Si el jefe ajustó desde qué hora cuentan las horas de este ingreso (la marca original no cambia)
  creditedFrom    DateTime?
  /// La aprobación que creó o ajustó esta marca; permite deshacerla
  justificationId String?
  createdAt       DateTime         @default(now())

  employee       Employee        @relation(fields: [employeeId], references: [id])
  site           Site?           @relation(fields: [siteId], references: [id])
  justifications Justification[] @relation("JustifiedMark")
  changedBy      Justification?  @relation("ChangedMarks", fields: [justificationId], references: [id], onDelete: SetNull)

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@index([siteId, timestamp])
  @@index([justificationId])
}

model Justification {
  id           String              @id @default(uuid())
  /// Una de las dos: la marcación justificada o el día de ausencia (CHECK en la migración)
  attendanceId String?
  date         DateTime?           @db.Date
  employeeId   String
  reason       String
  status       JustificationStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime            @default(now())

  attendance   Attendance?  @relation("JustifiedMark", fields: [attendanceId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  changedMarks Attendance[] @relation("ChangedMarks")
  reviewer     User?        @relation("Reviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([employeeId])
  @@index([employeeId, date])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

enum LeaveKind {
  VACATION
  MEDICAL
  PERSONAL
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

model Leave {
  id         String    @id @default(uuid())
  employeeId String
  kind       LeaveKind
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  note       String?
  createdBy  String
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  author   User     @relation("LeaveAuthor", fields: [createdBy], references: [id])

  @@index([employeeId, startDate])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
