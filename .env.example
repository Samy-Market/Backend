# --- Docker (PostgreSQL) ---
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=asistencia
POSTGRES_DB=asistencia
POSTGRES_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql://asistencia:asistencia@localhost:5433/asistencia?schema=public
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
# Minutos sin actividad antes de cerrar la sesión sola (0 = nunca)
SESSION_IDLE_MINUTES_STAFF=30
SESSION_IDLE_MINUTES_EMPLOYEE=10
# Intentos fallidos de ingreso antes de bloquear temporalmente ese correo (y, aparte, esa IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# Proxies delante de la API (Railway = 1) para conocer la IP real de quien ingresa
TRUST_PROXY_HOPS=1
# Recuperar contraseña por correo (Brevo). Sin clave, el correo se escribe en el log (útil en desarrollo).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SAMY Asistencia
# URL pública del frontend: ahí apunta el enlace del correo (por defecto, el primero de CORS_ORIGINS)
APP_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
APP_TIMEZONE=America/Guayaquil
MAX_SESSION_HOURS=16
